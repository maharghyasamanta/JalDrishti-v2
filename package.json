{
  "name": "india-water-disaster-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive India Water Disaster Intelligence Platform — a frontend prototype for exploring a decade of water-related disasters across India's states and Union Territories.",
  "scripts": {
    "dev": "npm run build && node server/index.js",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:server": "node --test server/states.test.js server/cap.test.js server/service.test.js server/phaseA.test.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=18"
  }
}
