# JalDrishti Server & Frontend Configuration
# Copy to .env for local development. Never commit real secrets.

# HTTP server bind address and port (default: 127.0.0.1:3000)
HOST=127.0.0.1
PORT=3000

# Admin API Bearer token (minimum 24 characters required; admin API returns 503 if unset/short)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated allowed origins for non-public endpoints and preflights
# When unset: allows localhost/127.0.0.1 (ports 3000/5173) in development, none in production
CORS_ORIGIN=

# Trust X-Forwarded-For client IP header when behind a reverse proxy ("true" or "false")
TRUST_PROXY=false

# SMS alerting defaults (keep mock/off in local & CI environments)
SMS_PROVIDER=mock
AUTO_DISPATCH_MODE=off
# Optional custom directory for persistent JSON store (defaults to server/data)
SMS_DATA_DIR=

# Upstream NDMA SACHET feed options
# ALERT_SCOPE: "all" (default) or "water"
ALERT_SCOPE=all
SACHET_USER_AGENT=
DISTRICT_INDEX_PATH=

# Frontend API overrides (optional; defaults to /api/alerts and /api/earthquakes)
VITE_ALERTS_URL=
VITE_EARTHQUAKES_URL=